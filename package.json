{
  "name": "strataflux",
  "version": "0.1.0",
  "description": "Work Item & PR Tray Monitor for Azure DevOps and GitHub",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-icons.mjs",
    "build:main": "tsc --project tsconfig.main.json",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "concurrently -k \"tsc --project tsconfig.main.json --watch\" \"vite --config vite.config.ts\"",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
